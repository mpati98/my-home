generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        String      @id @default(cuid())
  title     String
  tag       TaskTag
  priority  Priority
  status    TaskStatus  @default(waiting)
  done      Boolean     @default(false)
  doneAt    DateTime?
  dueDate   DateTime
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum TaskTag {
  Adhoc
  Event
  Fair
  External
  Data
  Learning
}

enum Priority {
  High
  Medium
  Low
}

enum TaskStatus {
  waiting
  processing
  on_time
  over_due
}

model Card {
  id          String       @id @default(cuid())
  title       String
  subtitle    String?
  category    CardCategory
  content     String
  tags        String[]
  spineColor  String       @default("#c9a96e")
  isFavorite  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum CardCategory {
  Book
  Experience
  Collection
}

model Topic {
  id          String      @id @default(cuid())
  title       String
  category    String
  description String
  coverColor  String      @default("#4a6fa5")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  subCards    SubCard[]
}



model LearnWord {
  id           String   @id @default(cuid())
  word         String
  type         String   @default("word")
  phonetic     String?
  partOfSpeech String?
  meaning      String
  description  String
  examples     String[]
  etymology    String?
  references   Json     @default("[]")
  tags         String[]
  isSaved      Boolean  @default(false)
  dailyDate    String?
  subCardId    String?  @unique
  topicId      String?
  createdAt    DateTime @default(now())
}

model SubCard {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId     String
}
